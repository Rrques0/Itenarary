# Server port
PORT=3210

# Ollama (local, free LLM for AI-assisted itinerary generation)
# Run `ollama list` to see what you already have pulled, and set this to match.
# Needs a model with decent instruction-following for reliable JSON output.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional: point at a self-hosted OpenTripPlanner instance to switch from the free
# OSM/OSRM fallback to real transit routing. Leave unset to use the fallback.
# OTP_BASE_URL=http://localhost:8080
